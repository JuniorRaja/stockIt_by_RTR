# Stocron by RTR - GPU-Enabled Docker Image (Blackwell/RTX 50-series Support)
# Uses NVIDIA CUDA 12.8 base for RTX 5070/5080/5090 (Blackwell sm_120) support
FROM nvidia/cuda:12.8.0-cudnn9-runtime-ubuntu22.04

# Set working directory
WORKDIR /app

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STREAMLIT_SERVER_PORT=8501 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    DEBIAN_FRONTEND=noninteractive \
    # CUDA environment
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH \
    # Build llama-cpp-python with CUDA support (set BEFORE pip install)
    CMAKE_ARGS="-DLLAMA_CUDA=on" \
    # Force CUDA architecture for Blackwell
    TORCH_CUDA_ARCH_LIST="8.0;8.6;9.0;12.0"

# Install system dependencies + Python 3.11
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3.11-dev \
    python3-pip \
    build-essential \
    curl \
    git \
    cmake \
    ninja-build \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Upgrade pip
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Copy requirements first (for better caching)
COPY requirements.txt .

# Remove conflicting system packages before pip install
RUN apt-get update && apt-get remove -y python3-blinker || true && \
    rm -rf /usr/lib/python3/dist-packages/blinker* || true && \
    rm -rf /var/lib/apt/lists/*

# ============================================================
# CRITICAL: Install PyTorch NIGHTLY with CUDA 12.8 for Blackwell (sm_120)
# RTX 5070/5080/5090 require this version
# ============================================================
RUN pip install --no-cache-dir --pre torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/nightly/cu128

# Install Python dependencies EXCLUDING torch (already installed above)
RUN grep -v "^torch" requirements.txt > requirements_no_torch.txt && \
    pip install --no-cache-dir --ignore-installed -r requirements_no_torch.txt && \
    pip install --no-cache-dir streamlit && \
    rm requirements_no_torch.txt

# Reinstall llama-cpp-python with CUDA support (CMAKE_ARGS already set in ENV)
RUN pip uninstall -y llama-cpp-python || true && \
    pip install --no-cache-dir llama-cpp-python --force-reinstall

# Optional: Install jugaad-data (India stock data)
RUN pip install --no-cache-dir jugaad-data --no-deps || true

# Clean up pip cache and temp files
RUN rm -rf /root/.cache/pip/* /tmp/* /var/tmp/*

# Copy application code (models excluded via .dockerignore)
COPY . .

# Create data directories (actual data mounted as volumes)
RUN mkdir -p data/cache/prices data/cache/financials data/cache/metadata data/db models

# Expose Streamlit port
EXPOSE 8501

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl --fail http://localhost:8501/_stcore/health || exit 1

# Run the application
CMD ["python", "-m", "streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]
